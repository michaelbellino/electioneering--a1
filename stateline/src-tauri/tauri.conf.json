{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stateline",
  "version": "0.1.0",
  "identifier": "com.stateline.game",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stateline",
        "width": 1440,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
